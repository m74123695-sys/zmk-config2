#include <behaviors.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // ==========================================
    // 1. 配置 SPI 总线与引脚 (针对 nRF52840)
    // ==========================================
    &spi1 {
        compatible = "nordic,nrf-spim";
        status = "okay";
        // 引用下面定义的引脚配置组
        pinctrl-0 = <&spi1_default>;
        pinctrl-1 = <&spi1_sleep>;
        pinctrl-names = "default", "sleep";
        // Latch (CS) 引脚：D5
        cs-gpios = <&pro_micro 5 GPIO_ACTIVE_LOW>;
    };

    // 手动分配 nRF52840 的 SPI 引脚
    &pinctrl {
        spi1_default: spi1_default {
            group1 {
                // Data (MOSI) 引脚：D4 (P0.22)
                psels = <NRF_PSEL(SPIM_MOSI, 0, 22)>,
                // Clock (SCK) 引脚：D6 (P1.00)
                        <NRF_PSEL(SPIM_SCK, 1, 0)>;
            };
        };
        spi1_sleep: spi1_sleep {
            group1 {
                psels = <NRF_PSEL(SPIM_MOSI, 0, 22)>,
                        <NRF_PSEL(SPIM_SCK, 1, 0)>;
                low-power-enable;
            };
        };
    };

    // ==========================================
    // 2. 配置 74HC595 级联 (两个芯片，共 16 个输出)
    // ==========================================
    &spi1 {
        shifter: 595@0 {
            compatible = "zmk,gpio-595";
            status = "okay";
            gpio-controller;
            #gpio-cells = <2>;
            reg = <0>;
            spi-max-frequency = <200000>;
            // 级联两个 595，提供 16 个 GPIO
            ngpios = <16>;
        };
    };

    // ==========================================
    // 3. 键盘扫描矩阵 (kscan)
    // ==========================================
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // 行 (Row)：来自 74HC595 的 16 个输出
        // 你实际只用了其中 8 个 (Q0-Q7)，但这里必须按顺序列全 16 个
        row-gpios
            = <&shifter 0 GPIO_ACTIVE_HIGH>
            , <&shifter 1 GPIO_ACTIVE_HIGH>
            , <&shifter 2 GPIO_ACTIVE_HIGH>
            , <&shifter 3 GPIO_ACTIVE_HIGH>
            , <&shifter 4 GPIO_ACTIVE_HIGH>
            , <&shifter 5 GPIO_ACTIVE_HIGH>
            , <&shifter 6 GPIO_ACTIVE_HIGH>
            , <&shifter 7 GPIO_ACTIVE_HIGH>
            , <&shifter 8 GPIO_ACTIVE_HIGH>
            , <&shifter 9 GPIO_ACTIVE_HIGH>
            , <&shifter 10 GPIO_ACTIVE_HIGH>
            , <&shifter 11 GPIO_ACTIVE_HIGH>
            , <&shifter 12 GPIO_ACTIVE_HIGH>
            , <&shifter 13 GPIO_ACTIVE_HIGH>
            , <&shifter 14 GPIO_ACTIVE_HIGH>
            , <&shifter 15 GPIO_ACTIVE_HIGH>;

        // 列 (Column)：直接连接到 nice!nano 的引脚
        // 根据你的方案：7, 8, 9, 10, 16, 14, 15, 18, 19, 20, 21
        col-gpios
            = <&pro_micro 7  GPIO_ACTIVE_HIGH>
            , <&pro_micro 8  GPIO_ACTIVE_HIGH>
            , <&pro_micro 9  GPIO_ACTIVE_HIGH>
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>;
    };

    // ==========================================
    // 4. 矩阵变换表 (Matrix Transform) - 核心！
    // ==========================================
    // 这里把我们之前确定的“物理行/列”映射到“逻辑按键位置”
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <16>;
        columns = <11>;

        map = <
            // 第一排：Esc, F1-F10
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10)
            // F11, F12, PrSc, Scrl, Paus
            RC(6,1)  RC(6,6)  RC(7,2)  RC(7,1)  RC(7,0)
            // 数字行：~, 1-0, -, =
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10)  RC(6,2)  RC(6,7)
            // BS, Ins, Home, PgUp
            RC(7,9)  RC(7,3)  RC(7,4)  RC(7,5)
            // Tab, Q-P, [, ], \
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10)  RC(6,3)  RC(6,8)  RC(7,10)
            // Del, End, PgDn
            RC(7,8)  RC(7,7)  RC(7,6)
            // Caps, A-L, ;, '
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10)  RC(6,4)
            // Enter
            RC(6,9)
            // LShift, Z-/, RShift, Up
            RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)  RC(4,10)  RC(6,5)  RC(6,10)
            // LCtrl, LWin, LAlt, Space, RAlt, RWin, Menu, RCtrl, Left, Down, Right
            RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)  RC(5,5)  RC(5,6)  RC(5,7)  RC(5,8)  RC(5,9)  RC(5,10)
        >;
    };

    // ==========================================
    // 5. 指定默认使用的扫描与变换
    // ==========================================
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };
};
